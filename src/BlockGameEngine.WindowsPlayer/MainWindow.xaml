<Window x:Class="BlockGameEngine.WindowsPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exported Block Game" Height="520" Width="760"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid Background="#111827">
        <Canvas x:Name="GameCanvas" Width="720" Height="460" ClipToBounds="True"
                MouseLeftButtonDown="GameCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="GameCanvas_MouseLeftButtonUp"/>
        <TextBlock x:Name="StatusText" Foreground="White" Background="#AA000000" Padding="8"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Window>
